# environments and caches
mixer/.venv/
.scratch/
.cache/
.envrc
**/__pycache__/
*.pyc
.DS_Store
# Xcode / app build output (regenerate with xcodegen + xcodebuild)
deck-app/build/
deck-app/tools/build/
deck-app/*.xcodeproj/xcuserdata/
deck-app/*.xcarchive
# audio and large derived data (commercial tracks; regenerate from the music folder)
*.mp3
*.wav
*.aac
*.m4a
*.iso
mixer/mixes/_work/
deck-app/Deck/Resources/Deck.shazamcatalog
# credentials
.env
*.p8
# derived from mixer/features via score.py (61 MB); regenerate, do not commit (decision D10)
mixer/pairs.json
# stage 1 benchmark harness build products and raw Music Understanding output (large; summarised by mixer/bench_mu.py)
tools/mubench/build/
tools/mubench/*.xcodeproj/xcuserdata/
mixer/mu_raw/
# Swift package build output (core/)
core/.build/
core/.swiftpm/
# ONNX Runtime's release (core/Tools/fetch-onnxruntime.sh) and the exported Beat This! and YAMNet models
# (core/Tools/export_beat_this.py, core/Tools/fetch-vocal-models.sh): fetched or made on each machine, pinned by hash
# in DEPENDENCIES.md
core/.deps/
core/.models/
# ...except Deckie's own generated test tones (core/Tools/make_audio_fixtures.py; no music), which the tests need
!core/Tests/DeckieDecodeTests/Fixtures/*.wav
!core/Tests/DeckieDecodeTests/Fixtures/*.mp3
!core/Tests/DeckieDecodeTests/Fixtures/*.m4a
# Claude Code agent worktrees (temporary checkouts the harness makes inside the repository)
.claude/worktrees/
desk-app/Vendor/
desk-app/build/
desk-app/*.xcodeproj

# device drop folder: nothing but its README is committed
ref/*
!ref/README.md

# Claude Code's local settings for this machine
.claude/settings.local.json
# site: build output, working renders and soundtrack trials (regenerate with site/build.sh and site/film/README.md)
site/dist/
site/dist-old-*/
site/assets/variations/
site/film/round*/
site/film/*.png
site/film/type-trials/*.png
site/film/sound/*.png
site/film/words/*.png
site/share/*.png
