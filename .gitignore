# environments and caches
mixer/.venv/
**/__pycache__/
*.pyc
.DS_Store
# Xcode / app build output (regenerate with xcodegen + xcodebuild)
deck-app/build/
deck-app/tools/build/
deck-app/*.xcodeproj/xcuserdata/
deck-app/*.xcarchive
# audio and large derived data (commercial tracks; regenerate from the music folder)
*.mp3
*.wav
*.aac
*.m4a
*.iso
mixer/mixes/_work/
deck-app/Deck/Resources/Deck.shazamcatalog
# credentials
.env
*.p8
# derived from mixer/features via score.py (61 MB); regenerate, do not commit (decision D10)
mixer/pairs.json
# stage 1 benchmark harness build products and raw Music Understanding output (large; summarised by mixer/bench_mu.py)
tools/mubench/build/
tools/mubench/*.xcodeproj/xcuserdata/
mixer/mu_raw/
# Swift package build output (core/)
core/.build/
core/.swiftpm/
# ONNX Runtime's release (core/Tools/fetch-onnxruntime.sh) and the exported Beat This! model
# (core/Tools/export_beat_this.py): fetched or made on each machine, pinned by hash in DEPENDENCIES.md
core/.deps/
core/.models/
# ...except Deckie's own generated test tones (core/Tools/make_audio_fixtures.py; no music), which the tests need
!core/Tests/DeckieDecodeTests/Fixtures/*.wav
!core/Tests/DeckieDecodeTests/Fixtures/*.mp3
!core/Tests/DeckieDecodeTests/Fixtures/*.m4a
# Claude Code agent worktrees (temporary checkouts the harness makes inside the repository)
.claude/worktrees/
