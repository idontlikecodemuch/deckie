# Optional. Plain Apache directives for shared hosting; each block is skipped if its module is absent.

# A page that is not here gets this site's own page. The path is from the web root: change it if the
# site is served from a folder and not from the root of its own domain.
ErrorDocument 404 /404.html

# Send everyone to https. The second condition is for hosts that end TLS in front of Apache.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # One address: www.deckie.io goes to deckie.io.
  RewriteCond %{HTTP_HOST} ^www\.deckie\.io$ [NC]
  RewriteRule ^ https://deckie.io%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddCharset utf-8 .html .txt .xml .svg
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/plain "access plus 10 minutes"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
